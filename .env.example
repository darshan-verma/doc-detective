# MongoDB Atlas (include database name in the path)
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/doc-detective?retryWrites=true&w=majority"
DATABASE_URL="mongodb://127.0.0.1:27017/doc-detective"

# Ed25519 PKCS8 private key (PEM). Newlines may be written as \n.
# Generate: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEILSEi4GERcJZPSR6zKIGi7uDvsuILLlPf++AU+f/MiFY\n-----END PRIVATE KEY-----"
ED25519_KEY_ID="local-dev"

# Signing provider: local | aws-kms
SIGNING_PROVIDER=local
# AWS_KMS_KEY_ID=...

# Keyed PRNG seed for watermark block order
WATERMARK_KEY="replace-with-a-long-random-watermark-key"

# Maximum upload size in megabytes (default 25)
MAX_UPLOAD_MB=25

# File storage: local disk (dev) or Vercel Blob (production)
# auto = Blob on Vercel / when BLOB_READ_WRITE_TOKEN is set; else local disk
STORAGE_PROVIDER=auto
STORAGE_DIR="./storage"
# Required for Blob locally; on Vercel OIDC works after the store is connected.
# Dashboard: Project → Storage → your Blob store → .env.local
# Or: vercel env pull
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# BLOB_STORE_ID="store_..."

# RFC 3161 timestamp authority
TSA_URL="https://freetsa.org/tsr"
CHECKPOINT_EVERY_N_ENTRIES=10

# Protects POST /api/cron/checkpoint
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional Redis for rate limiting (falls back to in-memory)
# REDIS_URL="redis://127.0.0.1:6379"

# Optional tuning
# WATERMARK_CONFIDENCE_MIN=0.7
# PHASH_MATCH_MAX=12
# TAMPER_SCORE_ALERT=1.5
# IMAGE_GRID_SIZE=32
# WATERMARK_QIM_STEP=24
