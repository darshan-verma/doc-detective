# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
endobj

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env & secrets — never commit
.env
.env.*
!.env.example
*.env
!*.env.example
*credentials*
atlas-credentials*

# private file storage & local db
/storage
/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# local planning notes (keep README / AGENTS)
improve.md
plan.md

# editor / IDE / agent
.idea/
.vscode/
!.vscode/extensions.json
.cursor/
.turbo/

# vercel
.vercel

# typescript
*.tsbuildinfo

# OS / backups
*~
*.swp
*.swo
*.bak
*.tmp
.cache/
.env*.local
