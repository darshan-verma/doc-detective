    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pkijs": "^3.4.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
